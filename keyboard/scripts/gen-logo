#!/usr/bin/env python3
"""Regenerate display/sd_logo.c -- the SD wordmark on the right OLED.

The output is committed, so a build needs neither this script nor Pillow.

Same rule as keymap.svg and reset-button-location.svg: art in this repo is
generated, never hand-pasted, so it can be re-derived and tweaked rather than
being an opaque blob of hex nobody dares touch.

FORMAT. LVGL 9's I1 (1 bit, indexed) descriptor, which is what ZMK's own
nice_view art uses at the pinned revision -- see zmk/app/boards/shields/
nice_view/widgets/art.c, copied here rather than invented:

    8 bytes  palette, two RGBA entries (index 0 = off, index 1 = on)
    then     ceil(w/8) bytes per row, MSB first, no row padding beyond that
    data_size counts the palette

Anything else (LV_COLOR_FORMAT_A1, an lv_image_dsc_t, a stride of 4-byte
multiples) is a different LVGL version's convention and will render as noise
or refuse to compile.

    ./scripts/gen-logo
"""

import subprocess
import sys
from pathlib import Path

W, H = 68, 32                      # leaves ~60px of the 128 for the widgets
FONT = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
OUT = Path(__file__).resolve().parent.parent / "display" / "sd_logo.c"


def render():
    from PIL import Image, ImageDraw, ImageFont

    img = Image.new("1", (W, H), 0)
    d = ImageDraw.Draw(img)

    # Fit "SD" to the box: grow the point size until it would overflow.
    size = 4
    while True:
        f = ImageFont.truetype(FONT, size + 1)
        l, t, r, b = d.textbbox((0, 0), "SD", font=f)
        if r - l > W - 6 or b - t > H - 10:
            break
        size += 1
    font = ImageFont.truetype(FONT, size)

    l, t, r, b = d.textbbox((0, 0), "SD", font=font)
    d.text(((W - (r - l)) // 2 - l, (H - 6 - (b - t)) // 2 - t), "SD", font=font, fill=1)

    # A rule under the wordmark, so it reads as a mark and not a stray glyph.
    d.rectangle([6, H - 4, W - 7, H - 3], fill=1)
    return img


def to_i1(img):
    stride = (W + 7) // 8
    rows = []
    px = img.load()
    for y in range(H):
        row = bytearray(stride)
        for x in range(W):
            if px[x, y]:
                row[x >> 3] |= 0x80 >> (x & 7)
        rows.append(bytes(row))
    return b"".join(rows), stride


def main():
    try:
        img = render()
    except (ImportError, OSError) as e:
        sys.exit(f"need Pillow and DejaVu Sans Bold: {e}")

    bits, stride = to_i1(img)
    data_size = 8 + len(bits)

    # A human-readable preview in the file, so a reviewer can see the art
    # without rendering anything.
    px = img.load()
    art = "\n".join(
        " * " + "".join("#" if px[x, y] else "." for x in range(W)) for y in range(H)
    )

    body = []
    for i in range(0, len(bits), 12):
        body.append("    " + " ".join(f"0x{b:02x}," for b in bits[i:i + 12]))

    OUT.parent.mkdir(exist_ok=True)
    OUT.write_text(f"""/*
 * SD wordmark for the right (peripheral) OLED.
 *
 * GENERATED by scripts/gen-logo -- do not edit by hand, edit the script.
 *
 * LVGL I1: an 8-byte palette (index 0 off, index 1 on) followed by
 * {stride} bytes per row, MSB first. data_size counts the palette.
 *
{art}
 */

#include <lvgl.h>

#ifndef LV_ATTRIBUTE_MEM_ALIGN
#define LV_ATTRIBUTE_MEM_ALIGN
#endif

static const LV_ATTRIBUTE_MEM_ALIGN LV_ATTRIBUTE_LARGE_CONST uint8_t sd_logo_map[] = {{
    0x00, 0x00, 0x00, 0xff, /* index 0 */
    0xff, 0xff, 0xff, 0xff, /* index 1 */

{chr(10).join(body)}
}};

const lv_img_dsc_t sd_logo = {{
    .header.cf = LV_COLOR_FORMAT_I1,
    .header.w = {W},
    .header.h = {H},
    .data_size = {data_size},
    .data = sd_logo_map,
}};
""")
    print(f"wrote {OUT}  ({W}x{H}, {data_size} bytes)")
    print("\n".join(art.splitlines()[4:H - 2]).replace(" * ", "  "))


if __name__ == "__main__":
    main()
